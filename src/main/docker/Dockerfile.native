####
# Native (GraalVM/Mandrel) image for GitHub Actions → Artifact Registry → Cloud Run.
#
# Build the native executable first (Linux, via Mandrel container):
#   ./mvnw -B -DskipTests -DskipITs package -Dnative -Dquarkus.native.container-build=true
#
# Then build the runtime image:
#   docker build -f src/main/docker/Dockerfile.native \
#     --build-arg GIT_REPO=https://github.com/React-CMS-JM/react-cms-content-service \
#     --build-arg GIT_SHA=$(git rev-parse HEAD) \
#     -t us-east1-docker.pkg.dev/PROJECT/react-cms/react-cms-content-service:native .
#
# Run (JWT_SECRET required — entrypoint materializes the verify JWK; same secret as auth):
#   docker run --rm -p 8080:8080 -e PORT=8080 -e JWT_SECRET=... -e DB_HOST=... ...
###
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.6

ARG GIT_REPO=https://github.com/React-CMS-JM/react-cms-content-service
ARG GIT_SHA=unknown

LABEL org.opencontainers.image.source=$GIT_REPO \
      org.opencontainers.image.revision=$GIT_SHA \
      org.opencontainers.image.title="react-cms-content-service" \
      org.opencontainers.image.description="React CMS content microservice (Quarkus Native)"

WORKDIR /work/
RUN microdnf install -y --nodocs coreutils \
    && microdnf clean all \
    && chown 1001 /work \
    && chmod "g+rwX" /work \
    && chown 1001:root /work

COPY --chown=1001:root --chmod=0755 target/*-runner /work/application
COPY --chown=1001:root --chmod=0755 src/main/docker/docker-entrypoint.sh /work/docker-entrypoint.sh

EXPOSE 8080
USER 1001

ENTRYPOINT ["/work/docker-entrypoint.sh"]
