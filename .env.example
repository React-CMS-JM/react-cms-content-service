# Template for local (.env) and production (.env.production) files.
# Copy to .env for localhost, or fill in prod values for Azure ACA secrets.
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=
# PREFERRED = local MySQL; VERIFY_IDENTITY = TiDB Cloud (CA already in JDK cacerts)
DB_SSL_MODE=PREFERRED
# Must match the auth-service issuer (content verifies auth's tokens)
JWT_ISSUER=
# Comma-separated; prod adds the Azure Static Web App URL, e.g. https://xxx.azurestaticapps.net
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
HTTP_PORT=8082
